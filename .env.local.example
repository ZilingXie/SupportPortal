# Local SupportPortal runtime settings.
# Copy this file to .env.local for local lightweight runtime defaults.
# The database default stays remote via .env; use --db local to opt into local Postgres/pgvector.

STACK_RUNTIME_MODE=local_lightweight
STACK_DB_MODE=remote

# Use --db local to opt into local Postgres/pgvector.

LOCAL_POSTGRES_USER=supportportal
LOCAL_POSTGRES_PASSWORD=supportportal
LOCAL_POSTGRES_DB=supportportal
LOCAL_POSTGRES_HOST_PORT=15432

LOCAL_TICKET_DB_SCHEMA=supportportal
LOCAL_PGVECTOR_SCHEMA=supportportal
LOCAL_PGVECTOR_TABLE=docagent_chunks_bge_m3_1024
LOCAL_PGVECTOR_DIM=1024

# Optional local tuning. External model and embedding API keys can stay in .env.
LOCAL_TICKET_DB_POOL_MIN_SIZE=1
LOCAL_TICKET_DB_POOL_MAX_SIZE=4
LOCAL_TICKET_DB_POOL_TIMEOUT_SECONDS=15
LOCAL_PGVECTOR_CONNECT_TIMEOUT=10
LOCAL_KNOWLEDGE_BM25_BACKFILL_ON_INIT=true
LOCAL_KNOWLEDGE_BM25_BACKFILL_ON_STARTUP=false
NGINX_HOST_PORT=8080

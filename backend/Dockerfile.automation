FROM python:3.11-slim AS runtime-base

ARG APP_BUILD_REF=unknown
ARG APP_BUILD_TIME=
ARG AUTOMATION_IMAGE_ROLE=automation

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_BUILD_REF=${APP_BUILD_REF} \
    APP_BUILD_TIME=${APP_BUILD_TIME}

WORKDIR /app

COPY requirements.base.txt /app/requirements.base.txt
RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir -r /app/requirements.base.txt

FROM runtime-base AS role-files

# Prune each role in a sibling build stage. The final image copies only this
# stage's merged filesystem, so removed source is absent from every final layer.
COPY backend /tmp/backend-src/backend
COPY ui /tmp/backend-src/ui
COPY docs /tmp/backend-src/docs
COPY dictionary /tmp/backend-src/dictionary
COPY deployment/automation_ecs_entrypoint.sh /app/automation_ecs_entrypoint.sh
RUN mkdir -p /app/backend /app/ui /app/docs /app/dictionary && \
    cp -a /tmp/backend-src/backend/. /app/backend/ && \
    cp -a /tmp/backend-src/ui/. /app/ui/ && \
    cp -a /tmp/backend-src/docs/. /app/docs/ && \
    cp -a /tmp/backend-src/dictionary/. /app/dictionary/ && \
    if [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-api" ]; then \
      rm -f /app/backend/main.py \
        /app/backend/worker.py \
        /app/backend/route_service.py \
        /app/backend/automation_runtime.py \
        /app/backend/automation_production_runtime.py \
        /app/backend/automation_ecs_route_worker.py \
        /app/backend/automation_ecs_worker.py \
        /app/backend/rag_api.py \
        /app/backend/rag_worker.py \
        /app/backend/services/automation_rerun_contracts.py \
        /app/backend/services/account_full_reroute.py \
        /app/backend/services/account_case_reroute.py \
        /app/backend/services/account_rerun_preflight.py \
        /app/backend/services/account_rerun_recovery.py \
        /app/backend/services/rag_reset.py; \
      rm -rf /app/backend/tests /app/backend/scripts /app/ui /app/docs /app/dictionary; \
      mkdir -p /app/backend/scripts; \
      cp /tmp/backend-src/backend/scripts/__init__.py /app/backend/scripts/__init__.py; \
      cp /tmp/backend-src/backend/scripts/automation_ecs_bootstrap.py /app/backend/scripts/automation_ecs_bootstrap.py; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-route" ]; then \
      rm -f /app/backend/main.py \
        /app/backend/worker.py \
        /app/backend/route_service.py \
        /app/backend/automation_runtime.py \
        /app/backend/automation_production_runtime.py \
        /app/backend/automation_ecs_api.py \
        /app/backend/automation_ecs_worker.py \
        /app/backend/rag_api.py \
        /app/backend/rag_worker.py \
        /app/backend/services/automation_rerun_contracts.py \
        /app/backend/services/account_full_reroute.py \
        /app/backend/services/account_case_reroute.py \
        /app/backend/services/account_rerun_preflight.py \
        /app/backend/services/account_rerun_recovery.py \
        /app/backend/services/automation_side_effects.py \
        /app/backend/services/automation_delivery_reconciliation.py \
        /app/backend/services/rag_reset.py; \
      rm -rf /app/backend/tests /app/backend/scripts /app/ui /app/docs /app/dictionary; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-worker" ]; then \
      rm -f /app/backend/main.py \
        /app/backend/route_service.py \
        /app/backend/automation_runtime.py \
        /app/backend/automation_production_runtime.py \
        /app/backend/automation_ecs_api.py \
        /app/backend/automation_ecs_route_worker.py \
        /app/backend/rag_api.py \
        /app/backend/rag_worker.py \
        /app/backend/services/automation_rerun_contracts.py \
        /app/backend/services/account_full_reroute.py \
        /app/backend/services/account_case_reroute.py \
        /app/backend/services/account_rerun_preflight.py \
        /app/backend/services/account_rerun_recovery.py \
        /app/backend/services/rag_reset.py; \
      rm -rf /app/backend/tests /app/backend/scripts /app/ui /app/docs /app/dictionary; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "production" ]; then \
      rm -f /app/backend/main.py \
        /app/backend/automation_runtime.py \
        /app/backend/services/automation_rerun_contracts.py \
        /app/backend/services/account_full_reroute.py \
        /app/backend/services/account_case_reroute.py \
        /app/backend/services/account_rerun_preflight.py \
        /app/backend/services/account_rerun_recovery.py \
        /app/backend/worker.py \
        /app/backend/services/rag_reset.py; \
      rm -rf /app/backend/scripts /app/backend/tests; \
      rm -rf /app/ui/automation-staging /app/ui/automation-preproduction \
        /app/ui/account-ui /app/ui/production-ui; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "route" ]; then \
      rm -f /app/backend/main.py /app/backend/automation_runtime.py \
        /app/backend/automation_production_runtime.py \
        /app/backend/services/route_client.py \
        /app/backend/services/automation_execution_store.py \
        /app/backend/services/automation_delivery_reconciliation.py \
        /app/backend/services/automation_side_effects.py \
        /app/backend/services/automation_rerun_contracts.py \
        /app/backend/services/account_automation_ownership.py \
        /app/backend/services/zendesk_comments.py \
        /app/backend/services/zendesk_ticket_assignment.py \
        /app/backend/services/account_full_reroute.py \
        /app/backend/services/account_case_reroute.py \
        /app/backend/services/account_rerun_preflight.py \
        /app/backend/services/account_rerun_recovery.py; \
      rm -rf /app/ui; \
    else \
      rm -f /app/backend/route_service.py; \
    fi && \
    chmod 0755 /app/automation_ecs_entrypoint.sh && \
    rm -rf /tmp/backend-src && \
    find /app -type f \( -name '*.pyc' -o -name '*.pyo' -o -name '*.pyd' \) -delete && \
    find /app -depth -type d -name '__pycache__' -exec rm -rf '{}' + && \
    if [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-api" ]; then \
      python -c 'import backend.automation_ecs_api'; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-route" ]; then \
      python -c 'import backend.automation_ecs_route_worker'; \
    elif [ "${AUTOMATION_IMAGE_ROLE}" = "ecs-worker" ]; then \
      AUTOMATION_ECS_ACCOUNT_ONLY=1 \
      TICKET_DB_DSN=postgresql://runtime.invalid/supportportal \
      TICKET_DB_SCHEMA=supportportal_production \
      python -c 'import backend.automation_ecs_worker, backend.worker'; \
    fi

FROM runtime-base AS final

ARG AUTOMATION_IMAGE_ROLE=automation
ENV AUTOMATION_IMAGE_ROLE=${AUTOMATION_IMAGE_ROLE}

COPY --from=role-files /app /app

ENTRYPOINT ["/app/automation_ecs_entrypoint.sh"]

EXPOSE 8000 8100

# /production environment (optional). Point at the existing production database
# used by the current /production stack. Do not point it at the account database.
# When non-empty, deploy_ec2.sh enables the compose "production" profile:
# api_production + worker_query_production + worker_aux_production, exposed via
# nginx at /production/, /production/api/* and POST /production/account.
# Must never equal TICKET_DB_DSN.
PRODUCTION_TICKET_DB_DSN=

# Split Route/Automation environments. They reuse the existing project database
# DSNs by default: staging/preproduction use TICKET_DB_DSN, production uses
# PRODUCTION_TICKET_DB_DSN. Each environment is isolated by its own schema,
# execution table, queue namespace and service token. Set an AUTOMATION_*_DB_DSN only when an
# explicit DSN override is required. Production Automation is built without
# the legacy Account rerun modules and UI. Normal split deployments should use
# deployment/build_automation_release.sh followed by deploy_ec2.sh --release;
# the six image variables below remain an emergency/legacy override path.
ROUTE_STAGING_IMAGE=registry.example/supportportal-route-staging@sha256:replace
ROUTE_PREPRODUCTION_IMAGE=registry.example/supportportal-route-preproduction@sha256:replace
ROUTE_PRODUCTION_IMAGE=registry.example/supportportal-route-production@sha256:replace
AUTOMATION_STAGING_IMAGE=registry.example/supportportal-automation-staging@sha256:replace
AUTOMATION_PREPRODUCTION_IMAGE=registry.example/supportportal-automation-preproduction@sha256:replace
AUTOMATION_PRODUCTION_IMAGE=registry.example/supportportal-automation-production@sha256:replace
ROUTE_STAGING_SERVICE_TOKEN=
ROUTE_PREPRODUCTION_SERVICE_TOKEN=
ROUTE_PRODUCTION_SERVICE_TOKEN=
AUTOMATION_STAGING_DB_DSN=
AUTOMATION_PREPRODUCTION_DB_DSN=
AUTOMATION_PRODUCTION_DB_DSN=
AUTOMATION_STAGING_DB_SCHEMA=supportportal_staging
AUTOMATION_PREPRODUCTION_DB_SCHEMA=supportportal_preproduction
AUTOMATION_PRODUCTION_DB_SCHEMA=supportportal_production
AUTOMATION_STAGING_DB_TABLE=automation_executions_staging
AUTOMATION_PREPRODUCTION_DB_TABLE=automation_executions_preproduction
AUTOMATION_PRODUCTION_DB_TABLE=automation_executions_production
AUTOMATION_RUNTIME_REQUIRE_RESOURCES=1
AUTOMATION_STAGING_QUEUE=automation.staging
AUTOMATION_PREPRODUCTION_QUEUE=automation.preproduction
AUTOMATION_PRODUCTION_QUEUE=automation.production
AUTOMATION_STAGING_EVENT_CHANNEL=automation.events.staging
AUTOMATION_PREPRODUCTION_EVENT_CHANNEL=automation.events.preproduction
AUTOMATION_PRODUCTION_EVENT_CHANNEL=automation.events.production
PREPRODUCTION_ZENDESK_TICKET_ALLOWLIST=
PREPRODUCTION_ZENDESK_SIDE_EFFECTS_ENABLED=0
PREPRODUCTION_TARGET_TICKET_STATUS=
PRODUCTION_ZENDESK_SIDE_EFFECTS_ENABLED=0
PRODUCTION_TARGET_TICKET_STATUS=
PRODUCTION_ACCOUNT_SLACK_N8N_WEBHOOK_URL=https://n8n.stellarix.space/webhook/4cada732-33cc-4648-808a-bb72a3d9f93a
PRODUCTION_ACCOUNT_SLACK_N8N_STATUS_URL=https://n8n.stellarix.space/webhook/supportportal/account-handoff/slack/status
# Unified token for ALL n8n <-> SupportPortal traffic (X-N8n-Request-Token header):
# inbound Zendesk comment/status sync, /automation/*/v1/* execution endpoints,
# and outbound Slack handoff webhook auth.
n8n_request_token=
PRODUCTION_ACCOUNT_SLACK_N8N_TIMEOUT_SECONDS=15

# Workspace authentication and system assignment
WORKSPACE_AUTH_SECRET=replace-with-a-long-random-secret
WORKSPACE_BOOTSTRAP_ADMIN_ID=admin
WORKSPACE_BOOTSTRAP_ADMIN_NAME=Workspace Admin
WORKSPACE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Base64-encoded `username:api-token` used only for server-side Zendesk ticket updates.
zendesk_basic_auth=
# Exact email of the active Zendesk Agent assigned by the Account Admin `Assign to AI` action.
ZENDESK_AI_ASSIGNEE_EMAIL=
# Numeric Zendesk user id of the agent who receives a fraud_account case after
# the automated public reply has been published (fraud review handoff). The AI
# agent token cannot search users by email, so the id is required (find it in
# the Zendesk admin user URL, e.g. /agent/users/31116634341396).
ZENDESK_FRAUD_REVIEW_ASSIGNEE_ID=
# Wait (seconds) after routing before the first AI ownership assignment PUT on
# a production automated case. Zendesk omnichannel routing keeps rejecting the
# assignment with 422 while the routed human agent holds the ticket (observed
# beyond a full minute), so the first attempt is deferred past that window.
# Set to 0 to assign immediately; empty falls back to the built-in default.
ZENDESK_OWNERSHIP_ASSIGNMENT_INITIAL_DELAY_SECONDS=90
# Comma-separated backoff delays (seconds) before retrying a 422-rejected AI
# ownership assignment. Zendesk omnichannel routing briefly rejects assignment
# writes right after a ticket is created and routed. Empty disables the retry.
ZENDESK_OWNERSHIP_ASSIGNMENT_RETRY_DELAYS_SECONDS=20,40
ENGINEER_ASSIGNMENT_SLA_HOURS=3
ENGINEER_ASSIGNMENT_POLLER_ENABLED=true
ENGINEER_ASSIGNMENT_POLL_INTERVAL_SECONDS=60
ENGINEER_MULTI_AGENT_ENABLED=false
ACCOUNT_NOT_AUTOMATED_ENGINEER_ROLLOUT_PERCENT=10
PGVECTOR_DSN=postgresql://USER:PASSWORD@YOUR_AWS_POSTGRES_HOST:5432/DATABASE?sslmode=require
PGVECTOR_SCHEMA=supportportal
PGVECTOR_TABLE=docagent_chunks_bge_m3_1024
PGVECTOR_DIM=1024
KNOWLEDGE_BM25_BACKFILL_ON_INIT=true
KNOWLEDGE_BM25_BACKFILL_ON_STARTUP=false
RAG_SERVICE_SHARED_TOKEN=change-me


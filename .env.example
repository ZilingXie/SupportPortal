OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMOTION_REPLY_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=20.0
EMOTION_REPLY_TIMEOUT_SECONDS=2.0
RAG_TOP_K=6

NGINX_HOST_PORT=8080
API_WORKERS=1
ASYNC_QUERY_ENABLED=true
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_NAME=support.tasks
RAG_QUEUE_NAME=support.rag.tasks
EVENT_BUS_CHANNEL=support.events
SENTIMENT_PROVIDER=model
SENTIMENT_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
SENTIMENT_MIN_CONFIDENCE=0.45

TICKET_DB_DSN=postgresql://USER:PASSWORD@YOUR_AWS_POSTGRES_HOST:5432/DATABASE?sslmode=require
TICKET_DB_SCHEMA=supportportal
PGVECTOR_DSN=postgresql://USER:PASSWORD@YOUR_AWS_POSTGRES_HOST:5432/DATABASE?sslmode=require
PGVECTOR_SCHEMA=supportportal
PGVECTOR_TABLE=docagent_chunks
RAG_SERVICE_SHARED_TOKEN=change-me

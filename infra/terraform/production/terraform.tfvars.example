aws_region   = "us-east-1"
project_name = "supportportal"
environment  = "production"

vpc_id                 = "vpc-0125f57b2ec2f0423"
public_subnet_ids      = []
efs_availability_zone_name = "us-east-1b"
# Required before enable_services=true. These refer to the existing Pilot
# credential EFS and access point; they are independent from graph-token-cache.
pilot_efs_file_system_id = ""
pilot_efs_access_point_id = ""
rds_security_group_id  = "sg-0e9c3bd50e371fbf4"
domain_name            = "supportcenter.stellarix.space"

# Keep false for Foundation-only apply. Enable only after the release thread
# publishes all three immutable image digests and the secrets are populated.
enable_services      = false
enable_https_listener = false

# After ACM DNS validation, set enable_https_listener=true. An existing issued
# certificate ARN may be supplied instead of using the Terraform-managed one.
acm_certificate_arn = ""

# Foundation uses one cost-first Redis node. Set false if the approved runtime
# design does not require Redis; do not remove the ECS SG boundary.
enable_redis       = true
redis_node_type    = "cache.t3.micro"
redis_engine_version = "7.1"

desired_count = 1
assign_public_ip = true

# These remain empty until the release manifest exists.
api_image    = ""
route_image  = ""
worker_image = ""
release_id   = "unreleased"
git_commit   = ""
build_time   = ""
prompt_release_id = ""

# Keep false until the controlled Production Case test is ready to write back
# to Zendesk. This does not affect the EC2 /production backup.
zendesk_side_effects_enabled = false

github_repository = "ZilingXie/SupportPortal"
github_branch     = "main"

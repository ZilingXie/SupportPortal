aws_region = "us-east-1"
vpc_id     = "vpc-REPLACE"

ecs_cluster_name          = "supportportal-production"
shared_alb_arn            = "arn:aws:elasticloadbalancing:us-east-1:ACCOUNT:loadbalancer/app/REPLACE"
shared_https_listener_arn = "arn:aws:elasticloadbalancing:us-east-1:ACCOUNT:listener/app/REPLACE"
shared_acm_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT:certificate/REPLACE"
ecs_security_group_id      = "sg-REPLACE"
shared_log_group_name      = "/ecs/supportportal/production"

shared_task_execution_role_name = "REPLACE"
shared_task_role_name           = "REPLACE"
shared_graph_efs_file_system_id = "fs-REPLACE"
shared_redis_replication_group_id = "REPLACE"
shared_ssm_parameter_names = [
  "/supportportal/production/account-suspension-internal-email-recipients",
  "/supportportal/production/hermes-base-url",
  "/supportportal/production/hermes-api-server-key",
]

api_task_definition_arn    = "arn:aws:ecs:us-east-1:ACCOUNT:task-definition/supportportal-production-api:REVISION"
route_task_definition_arn  = "arn:aws:ecs:us-east-1:ACCOUNT:task-definition/supportportal-production-route:REVISION"
worker_task_definition_arn = "arn:aws:ecs:us-east-1:ACCOUNT:task-definition/supportportal-production-worker:REVISION"

api_subnet_ids    = ["subnet-REPLACE-A", "subnet-REPLACE-B"]
route_subnet_ids  = ["subnet-REPLACE-A", "subnet-REPLACE-B"]
worker_subnet_ids = ["subnet-REPLACE-GRAPH-EFS-AZ"]

desired_count    = 1
assign_public_ip = true

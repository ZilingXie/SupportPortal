# Branch and external health target.
DEPLOY_BRANCH=main
DEPLOY_DOMAIN=support.stellarix.space

# Amazon SES alert settings.
DEPLOY_ALERT_TO=you@example.com
DEPLOY_ALERT_FROM=alerts@example.com
DEPLOY_AWS_REGION=us-east-1

# Optional overrides.
# DEPLOY_HEALTH_TIMEOUT_SECONDS=90
# DEPLOY_HEALTH_RETRY_INTERVAL_SECONDS=2

ARG HERMES_BASE_IMAGE
FROM ${HERMES_BASE_IMAGE}
# R2-V2-B1: combined profile + file-scope skill visibility fix on live base 180e2c98.
COPY hermes-agent/gateway/platforms/api_server_runs.py /opt/hermes/gateway/platforms/api_server_runs.py
COPY hermes-agent/tools/skills_tool.py /opt/hermes/tools/skills_tool.py
COPY hermes-agent/supportportal_file_context.py /opt/hermes/supportportal_file_context.py
COPY hermes-agent/supportportal_skill_profile.py /opt/hermes/supportportal_skill_profile.py
COPY deploy-ecs/supportportal_agent_tools /opt/hermes/plugins/supportportal_agent_tools
COPY deploy-ecs/case-files-skill /opt/hermes/case-files-skill
COPY investigation-profiles /opt/hermes/investigation-profiles

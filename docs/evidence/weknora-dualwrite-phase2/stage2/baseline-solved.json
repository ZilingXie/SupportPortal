   {
    "id": "225fb3c0-03ff-4aad-a4b9-c34d46745fb9",
    "name": "Geneate_KB_Content",
    "type": "@n8n/n8n-nodes-langchain.openAi",
    "typeVersion": 1.8,
    "position": [

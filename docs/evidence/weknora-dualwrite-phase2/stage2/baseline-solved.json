    "parameters": {
     "jsCode": "function cleanInput(input) {\n    // 1. 提取最内层有效数组（input[0].data）\n    const dataArray =input;\n    \n    // 2. 过滤空对象：保留至少包含一个有效键值对的对象\n    const filteredArray = dataArray.filter(item => {\n        return Object.keys(item).length > 0; // 仅保留非空对象[6,8](@ref)\n    });\n    \n    return filteredArray;\n}\n\n// 示例调用\n\nconst result = cleanInput($input.first().json.data);\nreturn {result}"
    }

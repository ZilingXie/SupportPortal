   {
    "id": "f1475024-9ed3-474c-b836-8c3b1dca3625",
    "name": "Mask1",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     -928,
     704
    ],
    "parameters": {
     "jsCode": "function maskSensitiveInfo(inputText) {\n  if (!inputText || typeof inputText !== 'string') return inputText;\n\n  // 步骤1：按单词分割文本（保留空格和标点）\n  const words = inputText.split(/(\\s+|\\W+)/); // 正则分割保留分隔符\n  const maskedWords = words.map(word => {\n    // 跳过非单词字符（如空格、标点）\n    if (!/\\w/.test(word)) return word;\n\n    // 步骤2：检查单词中数字总数 ≥5\n    const digitCount = (word.match(/\\d/g) || []).length;\n    if (digitCount < 5) return word;\n\n    // 步骤3：替换单词中的所有数字为 *\n    return word.replace(/\\d/g, '*');\n  });\n\n  return maskedWords.join('');\n}\n\n// Safely get the first item from the 'Loop Over each comment' node\nconst item = $('Loop Over each comment').first();\n\n// Check if the item and the required 'body' property exist before processing\nif (item && item.json && item.json.body) {\n  const res = maskSensitiveInfo(item.json.body);\n\n  return [{\n    result: res\n  }];\n}\n\n// If no item or body is found, return an empty array.\n// This tells n8n to stop this execution path without an error.\nreturn [];"
    }
   },
   {
    "id": "3fc0e778-eacd-4101-b225-edff9b9bc963",
    "name": "Conversation",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     -640,
     784
    ],
    "parameters": {
     "jsCode": "const rawEmail = $('HTTP Request').first()?.json?.user.email || '未找到邮箱';\nlet body = $input.first()?.json?.result || '未找到内容';\n//let time = $('AI_Filter').first().json.created_at;\n//let createTime= \"Created At\"\n\n// 移除所有换行符（兼容Windows/Unix/Mac系统）\nbody = body.replace(/(\\r\\n|\\n|\\r)/gm, ' '); // [2,5](@ref)\n\n// 处理邮箱格式\nlet processedEmail;\nif (rawEmail.endsWith('@agora.io')) {\n    processedEmail = 'agent'; \n} else {\n    processedEmail = 'Customer';\n}\n\n// 返回{邮箱: 内容}格式的对象\nreturn { \n    //[createTime]:time,\n    [processedEmail]: body    \n};"
    }
   },

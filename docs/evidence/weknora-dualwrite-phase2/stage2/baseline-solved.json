    "id": "524c9ee5-2fb9-4a38-8fcf-b3423c08eca0",
    "name": "Validate Snapshot Completeness",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     -2048,
     704
    ],
    "parameters": {
     "jsCode": "const ticketResponse = $('Get Ticket Snapshot').first().json;\nconst ticket = ticketResponse && ticketResponse.ticket;\nif (!ticket || !ticket.id) { throw new Error('Ticket snapshot missing or malformed'); }\nconst pages = $input.all().map(item => item.json).filter(body => body && Array.isArray(body.comments));\nif (pages.length === 0) { throw new Error('No comment pages fetched'); }\nconst lastPage = pages[pages.length - 1];\nif (lastPage.next_page !== null && lastPage.next_page !== undefined) { throw new Error('Comment pagination incomplete: next_page still present'); }\nconst comments = pages.flatMap(body => body.comments);\nif (typeof ticket.comment_count === 'number' && comments.length < ticket.comment_count) { throw new Error('Comment pagination incomplete: got ' + comments.length + ', expected ' + ticket.comment_count); }\nreturn [{ json: { ticket, comments } }];"
    }
   },

        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const input = $('When Executed by Another Workflow').first().json.Input;\nconst auth = $('Verify Slack Credential Workspace').first().json;\nconst info = $('Read Human Slack Channel').first().json;\nconst replies = $input.first().json;\nfunction requireSource(ok, reason) {\n  if (!ok) throw new Error('human_file_source_unverified: ' + reason);\n}\nrequireSource($input.all().length === 1 && $('When Executed by Another Workflow').all().length === 1, 'single input required');\nrequireSource(auth.ok === true && auth.team_id === 'T1CBEDLJY', 'credential workspace');\nrequireSource(info.ok === true && info.channel?.id === 'C0BS0N61D1R' && info.channel.context_team_id === auth.team_id, 'channel workspace');\nrequireSource(input.team == null || input.team === auth.team_id, 'event workspace');\nrequireSource(input.type === 'message' && input.subtype === 'file_share' && !input.bot_id && !input.bot_profile && input.channel === info.channel.id, 'human channel');\nrequireSource(/^U[A-Z0-9]+$/.test(String(input.user || '')) && input.user !== 'U08RVQSJQF2', 'human actor');\nrequireSource(/^\\d+\\.\\d+$/.test(String(input.ts || '')) && /^\\d+\\.\\d+$/.test(String(input.thread_ts || '')) && input.ts !== input.thread_ts, 'thread reply');\nrequireSource(replies.ok === true && Array.isArray(replies.messages) && replies.has_more !== true && !replies.response_metadata?.next_cursor, 'complete replies response');\nconst matches = replies.messages.filter(m => m.ts === input.ts);\nrequireSource(matches.length === 1, 'unique exact message');\nconst message = matches[0];\nrequireSource(message.type === 'message' && (!message.subtype || message.subtype === 'file_share') && !message.bot_id && !message.bot_profile && message.user === input.user && message.thread_ts === input.thread_ts, 'message actor/thread');\nrequireSource(typeof input.text === 'string' && message.text === input.text && message.text.includes('<@U08RVQSJQF2>') && message.text.replace(/<@U08RVQSJQF2>/g, '').trim().length > 0, 'mention/text');\nrequireSource(!input.client_msg_id || input.client_msg_id === message.client_msg_id, 'client message identity');\nrequireSource(!input.parent_user_id || input.parent_user_id === message.parent_user_id, 'parent identity');\nrequireSource(Array.isArray(input.files) && input.files.length > 0 && input.files.length <= 10 && Array.isArray(message.files) && message.files.length === input.files.length, 'file count');\nconst ids = input.files.map(f => f?.id);\nrequireSource(new Set(ids).size === ids.length && ids.every(id => typeof id === 'string' && /^F[A-Z0-9]+$/.test(id)), 'unique file identities');\nconst files = ids.map(id => {\n  const matchingFiles = message.files.filter(f => f.id === id);\n  requireSource(matchingFiles.length === 1, 'file membership');\n  const file = matchingFiles[0];\n  const offered = input.files.find(f => f.id === id);\n  requireSource(file.user === message.user && !file.is_tombstoned && !file.is_external && typeof file.name === 'string' && file.name.length > 0 && typeof file.mimetype === 'string' && Number.isSafeInteger(file.size) && file.size > 0 && file.size <= 50 * 1024 * 1024, 'file owner/metadata');\n  requireSource(offered.name === file.name && offered.mimetype === file.mimetype && offered.size === file.size, 'file metadata match');\n  return {id: file.id, name: file.name, mimetype: file.mimetype, size: file.size};\n});\nreturn [{json: {Input: {\n  type: message.type, subtype: 'file_share', team: auth.team_id, channel: info.channel.id,\n  ts: message.ts, thread_ts: message.thread_ts, user: message.user,\n  parent_user_id: message.parent_user_id || null, bot_id: null,\n  text: message.text, client_msg_id: message.client_msg_id || null, files\n}}, pairedItem: {item: 0}}];"

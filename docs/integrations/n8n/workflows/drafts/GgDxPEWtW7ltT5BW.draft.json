   {
    "id": "1aa74b6a-3789-41aa-b21f-3a8da1c9c4af",
    "name": "Validate CSD Snapshot",
    "parameters": {
     "jsCode": "// Stage 2 source-only (p2-194, review R1 fix): CSD completeness gate —\n// fail-closed before any delivery. fields.comment object, comments array and\n// a NUMERIC total must ALL be present (ingestion contract): a missing or\n// non-numeric total refuses delivery instead of falling back to length.\nconst issue = $input.first().json;\nconst fields = issue && issue.fields;\nif (!issue || !issue.key || !fields) { throw new Error('CSD snapshot incomplete: issue key/fields missing'); }\nconst comment = fields.comment;\nif (!comment || !Array.isArray(comment.comments)) { throw new Error('CSD snapshot incomplete: fields.comment missing'); }\nif (typeof comment.total !== 'number') { throw new Error('CSD snapshot incomplete: fields.comment.total missing or non-numeric'); }\nif (comment.comments.length < comment.total) {\n  throw new Error('CSD snapshot incomplete: got ' + comment.comments.length + ' comments, total ' + comment.total);\n}\nreturn [{ json: { issue: issue, comment_total: comment.total } }];",
     "mode": "runOnceForAllItems"
    },
    "position": [
     -1076,
     1088
    ],
    "type": "n8n-nodes-base.code",
    "typeVersion": 2
   },
   {
    "id": "89d12c34-d6b8-4337-990d-b8d02a1af17d",
    "name": "Build csd_issue Snapshot",
    "parameters": {
     "jsCode": "// Stage 2 source-only (p2-194): build a csd_issue knowledge-source-v1 snapshot.\nconst source = $input.first().json;\nconst issue = source.issue;\nif (!issue || !issue.key || !issue.fields) { throw new Error('snapshot build: issue key/fields missing'); }\nconst payload = {\n  issue: issue,\n  comment_count: source.comment_total,\n};\nconst canonical = JSON.stringify(payload);\nconst snapshot_hash = crypto.createHash('sha256').update(canonical).digest('hex');\nreturn [{ json: {\n  schema_version: 'knowledge-source-v1',\n  source_type: 'csd_issue',\n  source_id: String(issue.key),\n  source_updated_at: String(issue.fields.updated || issue.fields.created || ''),\n  payload: payload,\n  references: {\n    snapshot_hash: snapshot_hash,\n    snapshot_builder: 'n8n-csd-source-only',\n    captured_fields: 'issue.fields=*,comment'\n  }\n}}];",
     "mode": "runOnceForAllItems"
    },

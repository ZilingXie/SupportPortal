        "id": "p2190-status-intake",
        "name": "Build ECS ticket.updated intake",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1216,
          512
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const ticket = $('get_case_info').item.json.ticket;\nif (!ticket || !/^\\d+$/.test(String(ticket.id || ''))) throw new Error('Zendesk ticket id missing');\nconst status = String(ticket.status || '').trim().toLowerCase();\nif (!['new','open','pending','hold','solved','closed'].includes(status)) throw new Error('Invalid source ticket status');\nconst source = String(ticket.updated_at || '').trim();\nif (!/(Z|[+-]\\d{2}:\\d{2})$/.test(source) || !Number.isFinite(Date.parse(source))) throw new Error('Valid source updated_at with timezone required');\nconst version = new Date(source).toISOString();\nconst requester = ticket.requester || {};\nconst fields = Array.isArray(ticket.custom_fields) ? Object.fromEntries(ticket.custom_fields.map(f => [String(f.id), f.value])) : (ticket.custom_fields || {});\nreturn {json: {schema_version:'automation-intake-v1',event_id:'zendesk:automation.preproduction:ticket:'+ticket.id+':updated:'+version+':'+status,event_type:'ticket.updated',occurred_at:version,ticket:{id:String(ticket.id),status,subject:String(ticket.subject || ''),description:String(ticket.description || ''),requester:{id:ticket.requester_id == null ? null : String(ticket.requester_id),name:requester.name || null,email:requester.email || null,role:'end-user',is_agent:false},tags:Array.isArray(ticket.tags)?ticket.tags:[],custom_fields:fields,updated_at:version}}};"
        }

          "jsCode": "const TARGET_COMPANY_IDS = [\n  '1201099',\n  '200062458',\n  '1392055',\n  '1138100',\n  '1228534'\n  // Add more CompanyIDs here as strings.\n];\n\nconst companyId = String(\n  $json.organization?.organization_fields?.companyid ?? '',\n).trim();\n\nreturn {\n  json: {\n    ...$json,\n    routing: {\n      companyId,\n      companyIdResult: TARGET_COMPANY_IDS.includes(companyId) ? 'match' : 'no_match',\n    },\n  },\n};"

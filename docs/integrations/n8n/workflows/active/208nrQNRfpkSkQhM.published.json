      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH inserted AS (\n  INSERT INTO n8n_supportportal_slack_events (event_id, status, payload)\n  VALUES ($1, 'pending', $2::jsonb)\n  ON CONFLICT (event_id) DO NOTHING\n  RETURNING event_id, status, payload, slack_channel_id, slack_message_ts, failure_code\n)\nSELECT event_id, status, payload, slack_channel_id, slack_message_ts, failure_code, TRUE AS claimed\nFROM inserted\nUNION ALL\nSELECT event_id, status, payload, slack_channel_id, slack_message_ts, failure_code, FALSE AS claimed\nFROM n8n_supportportal_slack_events\nWHERE event_id = $1 AND NOT EXISTS (SELECT 1 FROM inserted);",
          "options": {
            "queryReplacement": "={{ [$('Validate Event1').first().json.event_id, JSON.stringify($('Validate Event1').first().json.event)] }}"
          }

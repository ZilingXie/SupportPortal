        "parameters": {
          "jsCode": "const body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst allowed = new Set(['schema_version','event_id','event_type','account_case_id','message_id','reply_intent','case_type','case_title','zendesk_ticket_id','zendesk_url','ticket_summary','message_text']);\nconst keys = Object.keys(body);\nif (keys.some(key => !allowed.has(key))) throw new Error('unsupported_event_field');\nif (Number(body.schema_version) !== 1 || String(body.event_type || '') !== 'account_automation_handoff_confirmed') throw new Error('invalid_event_contract');\nconst event = {};\nfor (const key of allowed) event[key] = body[key];\nfor (const key of ['event_id','account_case_id','message_id','reply_intent','case_type','case_title','zendesk_ticket_id','zendesk_url','ticket_summary','message_text']) {\n  if (!String(event[key] ?? '').trim()) throw new Error(`missing_event_field:${key}`);\n}\nif (!/^account-automation-slack:[^:]+:[^:]+$/.test(String(event.event_id))) throw new Error('invalid_event_id');\nreturn [{ json: { event, event_id: String(event.event_id) } }];"
        },
        "id": "6c1a23f4-64fc-463c-a895-72bf34859f10",
        "name": "Validate Event1",

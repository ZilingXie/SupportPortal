          "mode": "runOnceForEachItem",
          "jsCode": "const ticket = $('Get_Case_Info').item.json.ticket ?? {};\nconst comments = $('Get_Case_Comment1').item.json.comments ?? [];\nconst requester = $('Get_Requester_Info').item.json.user ?? {};\nconst organization = $json.organization ?? {};\nconst organizationFields = organization.organization_fields ?? {};\nconst source = comments[0]?.via?.source ?? {};\n\nconst firstNonEmpty = (...values) => {\n  for (const value of values) {\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return String(value).trim();\n    }\n  }\n  return '';\n};\n\nconst customerEmail = firstNonEmpty(\n  requester.email,\n  source.from?.address,\n  source.to?.address,\n  organizationFields.email,\n  organizationFields.company_email,\n  organizationFields.contact_email,\n  organizationFields.support_email,\n);\n\nconst customerName = firstNonEmpty(\n  requester.name,\n  source.from?.name,\n  source.to?.name,\n  organizationFields.company_name,\n  organization.name,\n);\n\nreturn {\n  json: {\n    ticket,\n    customer_name: customerName,\n    customer_email: customerEmail,\n    customer_company: firstNonEmpty(organizationFields.company_name, organization.name),\n  },\n};"
        },

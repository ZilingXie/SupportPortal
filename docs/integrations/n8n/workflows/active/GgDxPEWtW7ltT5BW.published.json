        "parameters": {
          "jsCode": "const detail = $input.first().json;\nif (!detail || !detail.key || !detail.fields) {\n  throw new Error('CSD issue snapshot missing key or fields');\n}\nconst fields = detail.fields;\nif (!fields.updated) {\n  throw new Error('CSD issue snapshot missing updated timestamp');\n}\nconst comment = fields.comment;\nif (!comment || typeof comment !== 'object' || !Array.isArray(comment.comments) || typeof comment.total !== 'number') {\n  throw new Error(`CSD comment structure missing or malformed (issue ${detail.key})`);\n}\nif (comment.comments.length < comment.total) {\n  throw new Error(`CSD comment pagination incomplete: got ${comment.comments.length} of ${comment.total} (issue ${detail.key})`);\n}\nreturn [{ json: {\n  schema_version: 'knowledge-source-v1',\n  source_type: 'csd_issue',\n  source_id: String(detail.key),\n  source_updated_at: fields.updated,\n  payload: { issue: detail },\n  references: { jira_url: `https://jira.agoralab.co/browse/${detail.key}` }\n} }];"
        }

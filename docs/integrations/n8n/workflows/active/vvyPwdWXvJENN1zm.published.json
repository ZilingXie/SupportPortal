  "workflow": {
    "name": "[review]Random",
    "description": "每个工作日北京时间 06:00 查询未解决且未 reviewed 的 Tier1 工单，为配置的每位负责人随机抽取 1 条，调用 [review]Case|Subflow 完成人工评审，并更新 reviewed 标签。",
    "nodes": [
      {
        "parameters": {
          "jsCode": "// 获取输入数据\nconst data = $input.all()[0].json;\n\n// 确保有数据\nif (!data.results || data.results.length === 0) {\n  return [{ json: { error: \"没有找到任何 case\" } }];\n}\n\n// 获取结果数组\nconst results = data.results;\nconst totalCases = results.length;\n\n// 确定要选择多少个案例（如果总数小于5，则选择所有）\nconst numToSelect = Math.min(1, totalCases);\n\n// 创建一个数组来存储已选择的索引，避免重复选择\nconst selectedIndices = new Set();\nconst selectedCases = [];\n\n// 随机选择不重复的案例\nwhile (selectedCases.length < numToSelect) {\n  const randomIndex = Math.floor(Math.random() * totalCases);\n  \n  // 如果这个索引还没有被选择过\n  if (!selectedIndices.has(randomIndex)) {\n    selectedIndices.add(randomIndex);\n    selectedCases.push(results[randomIndex]);\n  }\n}\n\n// 创建输出项，格式为包含 tag 和 caseid 的对象\nconst items = [];\nfor (const selectedCase of selectedCases) {\n  items.push({\n    json: {\n      tag: \"Random\",\n      caseId: selectedCase.id\n    }\n  });\n}\n\n// 返回输出\nreturn items;"
        },

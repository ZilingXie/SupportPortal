        "name": "update_tag"
      },
      {
        "parameters": {
          "jsCode": "// 1. 定义目标负责人ID列表\nconst targetAssignees = [\n  40430228336660,\n  31116972667028,\n  31222576351636,\n  31116509485716,\n  31116382774932,\n  37443910673684\n];\n\n// 2. 获取输入中的工单数组\nconst allTickets = $input.first().json.results || [];\n\n// 3. 按 assignee_id 分组工单\nconst groupedByAssignee = {};\nallTickets.forEach(ticket => {\n  const aid = ticket.assignee_id;\n  if (!groupedByAssignee[aid]) {\n    groupedByAssignee[aid] = [];\n  }\n  groupedByAssignee[aid].push(ticket);\n});\n\nconst output = [];\n\n// 4. 为每个目标负责人随机选取一个工单（如果有）\ntargetAssignees.forEach(id => {\n  const ticketsForThisUser = groupedByAssignee[id];\n  \n  if (ticketsForThisUser && ticketsForThisUser.length > 0) {\n    const randomIndex = Math.floor(Math.random() * ticketsForThisUser.length);\n    const selectedTicket = ticketsForThisUser[randomIndex];\n    \n    // 转换为所需格式，tag固定为\"Random\"\n    output.push({\n      tag: \"Random\",\n      caseId: selectedTicket.case_id || selectedTicket.id\n    });\n  }\n});\n\n// 5. 返回格式化后的数组\nreturn output;"
        },

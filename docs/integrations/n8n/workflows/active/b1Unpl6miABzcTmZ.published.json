      {
        "parameters": {
          "jsCode": "function processComments(comments) {\n  if (!Array.isArray(comments)) {\n    console.error(\"警告：comments 不是数组！实际值为：\", comments);\n    return [];\n  }\n  \n  return comments.map(comment => {\n    return {\n      author_id: comment.author_id,\n      //ispublic: comment.public,\n      body: comment.body\n    };\n  });\n}\n\nconst inputData = $input.first().json;\nconst processedData = processComments(inputData.comments);\n\n// 直接返回处理后的数组，不添加额外包装\nreturn processedData;"
        },

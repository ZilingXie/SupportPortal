        "parameters": {
          "jsCode": "// 获取输入数据\nconst inputData = $input.all();\n\n// 检查输入是否存在且包含所需字段\nif (inputData[0] && inputData[0].json.data && Array.isArray(inputData[0].json.data[\"Review Catagory\"])) {\n  const reviewCategories = inputData[0].json.data[\"Review Catagory\"];\n  \n  // 将数组转换为所需的字符串格式\n  const outputString = `${reviewCategories.join(', ')}`;\n  \n  // 返回字符串\n  return [{ json: { output: outputString } }];\n}\n\n// 如果没有数据，返回空字符串\nreturn [{ json: { output: '' } }];"
        },

      {
        "parameters": {
          "jsCode": "// 初始化一个数组来存放提取的 case id\nconst caseIds = [];\n\n// 检查输入数据的结构，并提取 id\nif ($input.first() && $input.first().json) {\n  const data = $input.first().json;\n\n  // 方法1：假设数据格式严格为 [{ results: [...] }]\n  if (Array.isArray(data) && data[0] && data[0].results) {\n    const tickets = data[0].results;\n    for (const ticket of tickets) {\n      if (ticket.id) {\n        caseIds.push(ticket.id);\n      }\n    }\n  }\n  // 方法2：更通用的方式，直接寻找 results 数组\n  else if (data.results) {\n    const tickets = data.results;\n    for (const ticket of tickets) {\n      if (ticket.id) {\n        caseIds.push(ticket.id);\n      }\n    }\n  } else {\n    // 如果数据结构不符，输出原始数据以便调试\n    console.log('未找到 results 数据，原始数据为:', JSON.stringify(data, null, 2));\n  }\n}\n\n// 将结果输出为指定的格式：包含 tag 和 caseid\nconst items = [];\nfor (const id of caseIds) {\n  // 为每个 ID 创建一个新的 item，包含固定 tag 和小写 caseid\n  items.push({\n    json: {\n      tag: \"Long Aged\",\n      caseId: id  // 注意：这里是小写的 caseid，不是 caseId\n    }\n  });\n}\n\n// 如果有提取到 ID，则输出 items；否则返回一个空数组\nreturn items.length > 0 ? items : [];"
        },

{
  "name": "SupportPortal - Zendesk Account comment sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "supportportal-zendesk-account-comment-sync",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "zendesk-ticket-updated",
      "name": "Zendesk ticket updated",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 300],
      "webhookId": "supportportal-zendesk-account-comment-sync"
    },
    {
      "parameters": {
        "jsCode": "const source = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst ticket = source.ticket && typeof source.ticket === 'object' ? source.ticket : source;\nconst ticketId = String(ticket.id || ticket.ticket_id || '').trim();\nif (!/^\\d+$/.test(ticketId)) throw new Error('Zendesk ticket id is missing or not numeric');\nreturn [{ json: { zendesk_ticket_id: ticketId, source_updated_at: String(ticket.updated_at || source.updated_at || new Date().toISOString()).trim() } }];"
      },
      "id": "extract-ticket",
      "name": "Extract ticket ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPPORTPORTAL_BASE_URL + '/api/integrations/zendesk/account-cases/' + $json.zendesk_ticket_id + '/comment-sync-target' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Zendesk-Account-Sync-Token",
              "value": "={{ $env.ZENDESK_ACCOUNT_SYNC_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "membership-check",
      "name": "Account Case membership check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.is_account_case }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "is-account-case",
      "name": "Is Account Case",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.ZENDESK_BASE_URL + '/api/v2/tickets/' + $('Extract ticket ID').item.json.zendesk_ticket_id + '/comments.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBearerAuth",
        "sendQuery": false,
        "options": {
          "pagination": {
            "paginationMode": "responseContainsNextURL",
            "nextURL": "={{ $response.body.next_page }}",
            "requestInterval": 200
          }
        }
      },
      "id": "fetch-zendesk-comments",
      "name": "Fetch Zendesk comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 220],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_WITH_N8N_CREDENTIAL_ID",
          "name": "Zendesk API - configure me"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ticket = $('Extract ticket ID').item.json;\nconst pages = $input.all().map(item => item.json || {});\nconst comments = pages.flatMap(page => Array.isArray(page.comments) ? page.comments : []);\nreturn [{ json: { source_updated_at: ticket.source_updated_at, snapshot_complete: true, comments: comments.map(comment => ({ id: comment.id, public: comment.public, author: { id: comment.author_id, name: comment.author_name, role: comment.author_role }, body: comment.body || comment.html_body || '', via_channel: comment.via && comment.via.channel, created_at: comment.created_at })) } }];"
      },
      "id": "build-snapshot",
      "name": "Build complete comment snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1180, 220]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.SUPPORTPORTAL_BASE_URL + '/api/integrations/zendesk/account-cases/' + $('Extract ticket ID').item.json.zendesk_ticket_id + '/comments' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Zendesk-Account-Sync-Token",
              "value": "={{ $env.ZENDESK_ACCOUNT_SYNC_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "sync-comments",
      "name": "Sync comments to SupportPortal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 220]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "not-account-case",
              "name": "status",
              "value": "ignored_not_account_case",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "ignore-non-account",
      "name": "Ignore non-Account Case",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [940, 420]
    }
  ],
  "connections": {
    "Zendesk ticket updated": {
      "main": [[{"node": "Extract ticket ID", "type": "main", "index": 0}]]
    },
    "Extract ticket ID": {
      "main": [[{"node": "Account Case membership check", "type": "main", "index": 0}]]
    },
    "Account Case membership check": {
      "main": [[{"node": "Is Account Case", "type": "main", "index": 0}]]
    },
    "Is Account Case": {
      "main": [
        [{"node": "Fetch Zendesk comments", "type": "main", "index": 0}],
        [{"node": "Ignore non-Account Case", "type": "main", "index": 0}]
      ]
    },
    "Fetch Zendesk comments": {
      "main": [[{"node": "Build complete comment snapshot", "type": "main", "index": 0}]]
    },
    "Build complete comment snapshot": {
      "main": [[{"node": "Sync comments to SupportPortal", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "supportportal-zendesk-account-comment-sync-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}

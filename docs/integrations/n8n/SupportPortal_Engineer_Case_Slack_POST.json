    {
      "parameters": {"resource": "message", "operation": "post", "channel": "REPLACE_WITH_SLACK_CHANNEL_ID", "text": "={{ $json.payload.message_text }}", "otherOptions": {}},
      "id": "e1000000-0000-4000-8000-000000000007",
      "name": "Send Root Message",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [490, -150],
      "credentials": {"slackApi": {"id": "REPLACE_WITH_SLACK_CREDENTIAL_ID", "name": "SupportPortal Slack"}}
    },
    {
      "parameters": {"operation": "executeQuery", "query": "WITH binding AS (INSERT INTO public.n8n_supportportal_engineer_slack_threads(engineer_case_id,slack_team_id,slack_channel_id,slack_thread_ts) VALUES($1,'REPLACE_WITH_SLACK_TEAM_ID','REPLACE_WITH_SLACK_CHANNEL_ID',$2) ON CONFLICT(engineer_case_id) DO NOTHING) UPDATE public.n8n_supportportal_engineer_slack_events SET status='delivered',updated_at=NOW() WHERE event_id=$3 RETURNING event_id,status,failure_code;", "options": {"queryReplacement": "={{ [$('Choose Delivery').first().json.engineer_case_id,$('Send Root Message').first().json.ts,$('Choose Delivery').first().json.event_id] }}"}},
      "id": "e1000000-0000-4000-8000-000000000008",
      "name": "Bind Root And Complete",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [730, -150],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "SupportPortal n8n PostgreSQL"}}
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.mode }}", "rightValue": "thread", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "id": "e1000000-0000-4000-8000-000000000009",

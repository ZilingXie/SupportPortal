      "position": [140, 0]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.mode }}", "rightValue": "root", "operator": {"type": "string", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "id": "e1000000-0000-4000-8000-000000000006",

      "credentials": {"httpHeaderAuth": {"id": "REPLACE_WITH_HEADER_AUTH_CREDENTIAL_ID", "name": "SupportPortal n8n Header Auth"}}
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst allowed = new Set(['schema_version','event_id','event_type','engineer_case_id','account_case_id','case_title','problem','route_reason','zendesk_ticket_id','zendesk_url','message_text','investigation_id','conversation_version','draft_version','customer_draft','guardrail_id','guardrail_version','action','blockers','failure_code']);\nif (Object.keys(body).some(k => !allowed.has(k))) throw new Error('unsupported_event_field');\nif (Number(body.schema_version) !== 1 || !String(body.event_id || '').trim() || !String(body.engineer_case_id || '').trim() || !String(body.message_text || '').trim()) throw new Error('invalid_event_contract');\nif ('team_id' in body || 'channel_id' in body || 'thread_ts' in body) throw new Error('destination_override_forbidden');\nconst root = String(body.event_type || '') === 'engineer_case_opened';\nreturn [{json:{event:body,event_id:String(body.event_id),engineer_case_id:String(body.engineer_case_id),root}}];"
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "Validate Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-690, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n INSERT INTO public.n8n_supportportal_engineer_slack_events(event_id,engineer_case_id,event_type,status,payload)\n VALUES ($1,$2,$3,'pending',$4::jsonb) ON CONFLICT(event_id) DO NOTHING\n RETURNING event_id,engineer_case_id,event_type,status,payload,TRUE AS claimed\n)\nSELECT * FROM inserted\nUNION ALL\nSELECT event_id,engineer_case_id,event_type,status,payload,FALSE AS claimed\nFROM public.n8n_supportportal_engineer_slack_events WHERE event_id=$1 AND NOT EXISTS(SELECT 1 FROM inserted);",
        "options": {"queryReplacement": "={{ [$('Validate Event').first().json.event_id,$('Validate Event').first().json.engineer_case_id,$('Validate Event').first().json.event.event_type,JSON.stringify($('Validate Event').first().json.event)] }}"}
      },
      "id": "e1000000-0000-4000-8000-000000000003",
      "name": "Claim Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-450, 0],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "SupportPortal n8n PostgreSQL"}}
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT e.event_id,e.status,e.claimed,e.payload,e.engineer_case_id,e.event_type,t.slack_thread_ts,t.active\nFROM (SELECT $1::text event_id,$2::text engineer_case_id,$3::text event_type,$4::boolean claimed,$5::jsonb payload,$6::text status) e\nLEFT JOIN public.n8n_supportportal_engineer_slack_threads t ON t.engineer_case_id=e.engineer_case_id;",
        "options": {"queryReplacement": "={{ [$json.event_id,$json.engineer_case_id,$json.event_type,$json.claimed,JSON.stringify($json.payload),$json.status] }}"}
      },
      "id": "e1000000-0000-4000-8000-000000000004",
      "name": "Resolve Thread",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-210, 0],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "SupportPortal n8n PostgreSQL"}}
    },
    {
      "parameters": {
        "jsCode": "const r=$json; if(!r.claimed) return [{json:{...r,mode:'existing'}}]; const root=String(r.event_type)==='engineer_case_opened'; if(root && r.slack_thread_ts) return [{json:{...r,mode:'existing'}}]; if(!root && (!r.slack_thread_ts || !r.active)) return [{json:{...r,mode:'failed',failure_code:'thread_binding_missing'}}]; return [{json:{...r,mode:root?'root':'thread'}}];"
      },
      "id": "e1000000-0000-4000-8000-000000000005",
      "name": "Choose Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [20, 0]
    },
    {
      "parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "strict", "version": 2}, "conditions": [{"leftValue": "={{ $json.claimed }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}], "combinator": "and"}, "options": {}},
      "id": "e1000000-0000-4000-8000-000000000014",

    {
      "parameters": {"resource": "message", "operation": "post", "channel": "REPLACE_WITH_SLACK_CHANNEL_ID", "messageType": "block", "blocksUi": "={{ JSON.stringify([{type:'section',text:{type:'mrkdwn',text:$json.payload.message_text}},...($json.payload.action?[{type:'actions',elements:[{type:'button',text:{type:'plain_text',text:$json.payload.action==='final_approve'?'Approve & publish':'Run guardrail'},action_id:$json.payload.action,...($json.payload.action==='final_approve'?{style:'primary'}:{}),value:JSON.stringify({action:$json.payload.action,investigation_id:$json.payload.investigation_id,draft_version:$json.payload.draft_version,guardrail_id:$json.payload.guardrail_id||null,guardrail_version:$json.payload.guardrail_version||null})}]}]:[])]) }}", "text": "={{ $json.payload.message_text }}", "otherOptions": {"thread_ts": "={{ $json.slack_thread_ts }}"}},
      "id": "e1000000-0000-4000-8000-000000000010",
      "name": "Reply In Thread",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [730, 20],
      "credentials": {"slackApi": {"id": "REPLACE_WITH_SLACK_CREDENTIAL_ID", "name": "SupportPortal Slack"}}
    },
    {
      "parameters": {"operation": "executeQuery", "query": "WITH closed AS (UPDATE public.n8n_supportportal_engineer_slack_threads SET active=FALSE,updated_at=NOW() WHERE engineer_case_id=$2 AND $3='engineer_case_closed') UPDATE public.n8n_supportportal_engineer_slack_events SET status='delivered',updated_at=NOW() WHERE event_id=$1 RETURNING event_id,status,failure_code;", "options": {"queryReplacement": "={{ [$('Choose Delivery').first().json.event_id,$('Choose Delivery').first().json.engineer_case_id,$('Choose Delivery').first().json.event_type] }}"}},
      "id": "e1000000-0000-4000-8000-000000000011",
      "name": "Complete Thread Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [970, 20],
      "credentials": {"postgres": {"id": "REPLACE_WITH_POSTGRES_CREDENTIAL_ID", "name": "SupportPortal n8n PostgreSQL"}}
    },
    {
      "parameters": {"operation": "executeQuery", "query": "UPDATE public.n8n_supportportal_engineer_slack_events SET status='failed',failure_code=$2,updated_at=NOW() WHERE event_id=$1 AND status='pending' RETURNING event_id,status,failure_code;", "options": {"queryReplacement": "={{ [$('Choose Delivery').first().json.event_id,$('Choose Delivery').first().json.failure_code] }}"}},
      "id": "e1000000-0000-4000-8000-000000000013",

    },
    {
      "parameters": {"jsCode": "const r=$json; return [{json:{event_id:String(r.event_id||$('Choose Delivery').first().json.event_id),status:String(r.status||($('Choose Delivery').first().json.mode==='failed'?'failed':'pending')),failure_code:r.failure_code||$('Choose Delivery').first().json.failure_code||null}}];"},
